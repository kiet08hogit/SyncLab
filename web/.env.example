# Copy to .env.local. Every variable is optional: without them the dashboard
# still runs on sample data, and Settings explains what is missing.

# The NestJS gateway in server/api. Signed-in pages call it with the user's
# own GitHub token, so the dashboard holds no API secret of its own.
SYNCLAB_API_URL=http://localhost:3000

# The SyncLab GitHub App (Settings > Developer settings > GitHub Apps).
# Set its callback URL to http://localhost:3001/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's URL name, as in https://github.com/apps/<slug>.
GITHUB_APP_SLUG=
# Only for GitHub Enterprise Server: its API and its web host, used for sign-in.
# GITHUB_API_URL=https://api.github.com
# GITHUB_URL=https://github.com

# Only for a registry mirror. The new-migration form lists versions from it.
# NPM_REGISTRY_URL=https://registry.npmjs.org

# Encrypts the session cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET=
