# Copy to .env.local. Every variable is optional: without them the dashboard
# still runs on sample data, and Settings explains what is missing.

# The NestJS gateway in server/api, and the same MIGRATIONS_API_TOKEN it uses.
# Needed to start migrations from the form and to read real jobs.
SYNCLAB_API_URL=http://localhost:3000
MIGRATIONS_API_TOKEN=

# The SyncLab GitHub App (Settings > Developer settings > GitHub Apps).
# Set its callback URL to http://localhost:3001/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's URL name, as in https://github.com/apps/<slug>.
GITHUB_APP_SLUG=
# Only for GitHub Enterprise Server.
# GITHUB_API_URL=https://api.github.com

# Encrypts the session cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET=
