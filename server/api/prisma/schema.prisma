generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Repository {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  githubRepoId    BigInt         @unique @map("github_repo_id")
  fullName        String         @map("full_name") @db.VarChar(255)
  installationId  BigInt         @map("installation_id")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  
  migrationJobs   MigrationJob[]
  scans           RepositoryScan[]
  impacts         ApiImpact[]

  @@map("repositories")
}

model MigrationJob {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repositoryId    String         @map("repository_id") @db.Uuid
  dependencyName  String         @map("dependency_name") @db.VarChar(255)
  targetVersion   String         @map("target_version") @db.VarChar(50)
  status          String         @default("QUEUED") @db.VarChar(50)
  pullRequestUrl  String?        @map("pull_request_url") @db.VarChar(255)
  errorMessage    String?        @map("error_message")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  repository      Repository     @relation(fields: [repositoryId], references: [id])
  executionLogs   ExecutionLog[]

  @@unique([repositoryId, dependencyName, targetVersion])
  @@map("migration_jobs")
}

model ExecutionLog {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId           String         @map("job_id") @db.Uuid
  step            String         @db.VarChar(100)
  output          String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  job             MigrationJob   @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("execution_logs")
}

/// An external API SyncLab watches. Seeded with anthropic and openai.
model ApiProvider {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String         @unique @db.VarChar(50)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()

  usages          ApiUsage[]
  sources         ApiSource[]
  changes         BreakingChange[]

  @@map("api_providers")
}

/// One pass of the scanner over a repository's default branch.
model RepositoryScan {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  repositoryId    String         @map("repository_id") @db.Uuid
  /// installation, push or manual.
  trigger         String         @db.VarChar(50)
  status          String         @default("QUEUED") @db.VarChar(50)
  /// Set to the repository while the scan waits to start, so a repository has
  /// at most one waiting scan: a second trigger finds it instead of queueing
  /// another. Cleared when a worker starts the scan.
  queuedFor       String?        @unique @map("queued_for") @db.Uuid
  commitSha       String?        @map("commit_sha") @db.VarChar(40)
  errorMessage    String?        @map("error_message")
  /// The clone and scan step output, for diagnosing a scan.
  output          String?
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  repository      Repository     @relation(fields: [repositoryId], references: [id])
  usages          ApiUsage[]

  @@index([repositoryId, createdAt])
  @@map("repository_scans")
}

/// One call to a provider's API, found by a scan.
model ApiUsage {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scanId          String         @map("scan_id") @db.Uuid
  providerId      String         @map("provider_id") @db.Uuid
  file            String         @db.VarChar(1024)
  line            Int
  /// sdk or http.
  style           String         @db.VarChar(10)
  /// The SDK method path relative to the client, such as beta.messages.stream.
  method          String?        @db.VarChar(255)
  /// Such as POST /v1/messages. Null when the scanner has no operation for the call.
  operation       String?        @db.VarChar(255)
  params          String[]
  modelIds        String[]       @map("model_ids")
  dynamic         Boolean

  scan            RepositoryScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  provider        ApiProvider    @relation(fields: [providerId], references: [id])

  @@index([scanId])
  @@index([providerId, operation])
  @@map("api_usages")
}

/// A page or file the monitor polls for a provider, such as its model
/// deprecations page.
model ApiSource {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId    String    @map("provider_id") @db.Uuid
  /// deprecations, spec, release_notes or sdk_changelog.
  kind          String    @db.VarChar(50)
  url           String    @db.VarChar(1024)
  /// The last fetch, whether or not it succeeded or changed anything.
  lastCheckedAt DateTime? @map("last_checked_at") @db.Timestamptz()
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  provider  ApiProvider         @relation(fields: [providerId], references: [id])
  snapshots ApiSourceSnapshot[]

  @@unique([providerId, kind, url])
  @@map("api_sources")
}

/// A fetched source whose content differed from the previous snapshot. The
/// content is the extracted text the parsers read, not the raw page, so page
/// chrome that changes on every request does not create new snapshots.
model ApiSourceSnapshot {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId    String   @map("source_id") @db.Uuid
  /// sha256 of content.
  contentHash String   @map("content_hash") @db.VarChar(64)
  content     String
  fetchedAt   DateTime @default(now()) @map("fetched_at") @db.Timestamptz()

  source  ApiSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  changes BreakingChange[]

  @@index([sourceId, fetchedAt])
  @@map("api_source_snapshots")
}

/// A breaking change a provider announced, read from a snapshot.
model BreakingChange {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId  String    @map("provider_id") @db.Uuid
  /// The latest snapshot the change was read from.
  snapshotId  String    @map("snapshot_id") @db.Uuid
  /// model_retired, param_removed, param_renamed, param_now_required,
  /// enum_value_removed, endpoint_removed or behavior_changed.
  kind        String    @db.VarChar(50)
  /// Such as POST /v1/messages. Null when the change is not about one operation.
  operation   String?   @db.VarChar(255)
  /// The parameter or model ID the change is about.
  field       String?   @db.VarChar(255)
  replacement String?   @db.VarChar(1024)
  effectiveAt DateTime? @map("effective_at") @db.Date
  /// The heading the evidence sits under, such as an announcement title.
  section     String?   @db.VarChar(1024)
  /// The verbatim line of the snapshot the change was read from.
  evidence    String
  /// detected, confirmed or dismissed.
  status      String    @db.VarChar(20)
  /// operation and field joined, so the same change read again updates the
  /// existing row instead of adding one.
  subjectKey  String    @map("subject_key") @db.VarChar(512)
  detectedAt  DateTime  @default(now()) @map("detected_at") @db.Timestamptz()
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  provider ApiProvider       @relation(fields: [providerId], references: [id])
  snapshot ApiSourceSnapshot @relation(fields: [snapshotId], references: [id])
  impacts  ApiImpact[]

  @@unique([providerId, kind, subjectKey])
  @@index([status, detectedAt])
  @@map("breaking_changes")
}

/// Repositories a confirmed breaking change affects, recomputed from the
/// newest completed scan. confidence is confirmed or possible.
model ApiImpact {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  breakingChangeId String @map("breaking_change_id") @db.Uuid
  repositoryId     String @map("repository_id") @db.Uuid
  confidence       String @db.VarChar(20)
  files            String[]

  breakingChange BreakingChange @relation(fields: [breakingChangeId], references: [id], onDelete: Cascade)
  repository     Repository     @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([breakingChangeId, repositoryId])
  @@index([repositoryId])
  @@map("api_impacts")
}
