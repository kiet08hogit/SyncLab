# --- Datastores -------------------------------------------------------------
# Matches the services in server/docker-compose.yml.
DATABASE_URL="postgresql://admin:password@localhost:5432/synclab"
REDIS_HOST="localhost"
REDIS_PORT=6379

PORT=3000

# all = one process (default). gateway = webhooks only. worker = sandbox
# jobs only. Run extra `npm run start:worker` processes to take more jobs.
# APP_ROLE="all"
# WORKER_CONCURRENCY=1

# --- GitHub -----------------------------------------------------------------
# Required. GitHub signs every webhook with this secret and the gateway rejects
# any request whose signature does not match.
GITHUB_WEBHOOK_SECRET=""

# Preferred credentials. The worker mints a short-lived installation token per
# job; the private key itself never enters a sandbox container.
# GITHUB_APP_ID=""
# Either inline with escaped newlines, or point at the .pem file.
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# GITHUB_PRIVATE_KEY_PATH="./synclab.private-key.pem"

# Local development fallback, used only when no App is configured. Needs repo scope.
GITHUB_TOKEN=""

# GITHUB_API_URL="https://api.github.com"

# Service credential for /migrations and /repositories, for scripts and
# automation. It may act on any repository. Users authenticate with their own
# GitHub App user token instead, so this can stay empty.
# Generate one with `openssl rand -hex 32`.
MIGRATIONS_API_TOKEN=""

# --- Model ------------------------------------------------------------------
# Which model provider the refactor phase uses: "ollama" (default), "gemini"
# or "anthropic". Deployments use a hosted one; local development uses ollama.
LLM_PROVIDER="ollama"

# Defaults to qwen2.5-coder:14b for ollama, gemini-3.1-pro-preview for gemini
# and claude-opus-5-5 for anthropic.
# For ollama, pull it first: `ollama pull qwen2.5-coder:14b`.
# LLM_MODEL="qwen2.5-coder:14b"

# Ollama only. Resolved from inside the sandbox container, so this is the host
# as Docker Desktop exposes it, not localhost. Start the server with
# `brew services start ollama`.
# LLM_BASE_URL="http://host.docker.internal:11434"

# Ollama only. Context window in tokens. Ollama truncates past it without an
# error, and a whole file goes both in and out, so a file whose prompt and
# rewrite do not fit is refused with an error. Each character counts as a
# third of a token, so the default fits files up to roughly 45 KB, less when
# the release notes are long.
# LLM_NUM_CTX=32768

# Gemini only. Create a key at https://aistudio.google.com/apikey. It is passed
# only to the refactor container, never to the phase that runs repository code.
GEMINI_API_KEY=""

# Anthropic only. Create a key at https://platform.claude.com/settings/keys. Like
# the Gemini key, only the refactor container receives it.
ANTHROPIC_API_KEY=""

# How many times to rewrite and re-run the test suite before giving up. Each
# attempt is a fresh round of model calls, so these ceilings are the only brake
# on what one job can cost.
LLM_MAX_ATTEMPTS=3
LLM_MAX_FILES=20
LLM_MAX_FILE_BYTES=60000

# --- API change monitor -----------------------------------------------------
# Workers poll the Anthropic and OpenAI deprecation pages, OpenAI's OpenAPI
# spec, and both providers' release notes and SDK changelogs on this schedule.
# Classifying release notes uses LLM_PROVIDER, which must be gemini or
# anthropic. Set API_MONITOR_ENABLED=false to stop the schedule.
# API_MONITOR_ENABLED=true
# API_MONITOR_INTERVAL_MS=21600000

# GitHub logins, comma-separated and case-insensitive, that may confirm or
# dismiss a breaking change. A change is global, so other users can only read
# them. Empty means only MIGRATIONS_API_TOKEN may confirm or dismiss.
# MONITOR_ADMIN_LOGINS="octocat,hubot"

# --- Sandbox ----------------------------------------------------------------
# Build with `npm run sandbox:build`.
SANDBOX_IMAGE="synclab-sandbox:latest"
SANDBOX_TIMEOUT_MS=600000
SANDBOX_MEMORY_MB=2048
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=512

# Docker Desktop on macOS often exposes the socket under $HOME rather than at
# /var/run/docker.sock, which is where dockerode looks by default.
# DOCKER_SOCKET_PATH="/Users/you/.docker/run/docker.sock"
