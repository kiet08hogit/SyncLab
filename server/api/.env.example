# --- Datastores -------------------------------------------------------------
# Matches the services in server/docker-compose.yml.
DATABASE_URL="postgresql://admin:password@localhost:5432/synclab"
REDIS_HOST="localhost"
REDIS_PORT=6379

PORT=3000

# all = one process (default). gateway = webhooks only. worker = sandbox
# jobs only. Run extra `npm run start:worker` processes to take more jobs.
# APP_ROLE="all"
# WORKER_CONCURRENCY=1

# --- GitHub -----------------------------------------------------------------
# Required. GitHub signs every webhook with this secret and the gateway rejects
# any request whose signature does not match.
GITHUB_WEBHOOK_SECRET=""

# Preferred credentials. The worker mints a short-lived installation token per
# job; the private key itself never enters a sandbox container.
# GITHUB_APP_ID=""
# Either inline with escaped newlines, or point at the .pem file.
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# GITHUB_PRIVATE_KEY_PATH="./synclab.private-key.pem"

# Local development fallback, used only when no App is configured. Needs repo scope.
GITHUB_TOKEN=""

# GITHUB_API_URL="https://api.github.com"

# --- Model ------------------------------------------------------------------
# Required. Create a key at https://aistudio.google.com/apikey. It is passed
# only to the refactor container, never to the phase that runs repository code.
GEMINI_API_KEY=""

# Preview model names are retired without notice; if a job fails with a 404
# naming the model, list the current ones and set this.
# LLM_MODEL="gemini-3.1-pro-preview"

# How many times to rewrite and re-run the test suite before giving up. Each
# attempt is a fresh round of model calls, so these ceilings are the only brake
# on what one job can cost.
LLM_MAX_ATTEMPTS=3
LLM_MAX_FILES=20
LLM_MAX_FILE_BYTES=60000

# --- Sandbox ----------------------------------------------------------------
# Build with `npm run sandbox:build`.
SANDBOX_IMAGE="synclab-sandbox:latest"
SANDBOX_TIMEOUT_MS=600000
SANDBOX_MEMORY_MB=2048
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=512

# Docker Desktop on macOS often exposes the socket under $HOME rather than at
# /var/run/docker.sock, which is where dockerode looks by default.
# DOCKER_SOCKET_PATH="/Users/you/.docker/run/docker.sock"
